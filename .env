# ==========================================================================
# Configuração do Sistema de Assinaturas de E-mail — copie para ".env"
# NUNCA versione o arquivo ".env" real (contém segredos).
# ==========================================================================

# Ambiente: development | production
APP_ENV=production

# Chave secreta da aplicação (sessões, CSRF). Gere uma nova e única por ambiente:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=b7680e77e6eb169e37ca9092dfd9489907613d67b909abb1e873a9a83748a23c

# Cookies de sessão só via HTTPS (mantenha "true" em produção; use "false" apenas
# em desenvolvimento local sem HTTPS).
SESSION_COOKIE_SECURE=false

# Conta do administrador criada automaticamente no primeiro start (apenas se
# ainda não existir nenhum administrador no banco).
ADMIN_SEED_NAME=Emissor de Assinaturas
ADMIN_SEED_USERNAME=EmAssinaturas
ADMIN_SEED_PASSWORD=Admin@123

# Banco de dados (padrão: SQLite em /app/instance/app.db, persistido via volume)
# Para usar PostgreSQL futuramente: postgresql+psycopg2://usuario:senha@host:5432/banco
DATABASE_URL=

# Limite de tamanho de imagem final (redimensionamento sem perda perceptível)
OUTPUT_MAX_WIDTH=1300
JPEG_QUALITY=88

# Armazenamento do limitador de requisições (memory:// para instância única)
RATELIMIT_STORAGE_URI=memory://

# Porta interna do Gunicorn (mapeada para 5002 no host via docker-compose)
PORT=5002

