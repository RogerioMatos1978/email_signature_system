# ==========================================================================
# Configuração do Sistema de Assinaturas de E-mail — copie para ".env"
# NUNCA versione o arquivo ".env" real (contém segredos).
# ==========================================================================

# Ambiente: development | production
APP_ENV=production

# Chave secreta da aplicação (sessões, CSRF). Gere uma nova e única por ambiente:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-esta-chave-antes-de-subir-em-producao

# Cookies de sessão só via HTTPS (mantenha "true" apenas se o acesso for por HTTPS).
# Importante: navegadores só dispensam essa exigência para "localhost" — se o
# acesso for por IP de rede local (ex.: http://192.168.x.x:5002) sem HTTPS, deixe
# "false", senão o login nunca fica salvo (o cookie de sessão é descartado).
SESSION_COOKIE_SECURE=false

# Conta do administrador criada automaticamente no primeiro start (apenas se
# ainda não existir nenhum administrador no banco). O login do sistema é feito
# por USUÁRIO (não por e-mail). No primeiro acesso, a senha abaixo precisará
# ser trocada — é só uma senha temporária inicial.
ADMIN_SEED_NAME=Emissor de Assinaturas
ADMIN_SEED_USERNAME=EmAssinaturas
ADMIN_SEED_PASSWORD=Admin@123

# Banco de dados (padrão: SQLite em /app/instance/app.db, persistido via volume)
# Para usar PostgreSQL futuramente: postgresql+psycopg2://usuario:senha@host:5432/banco
DATABASE_URL=

# Limite de tamanho de imagem final (redimensionamento sem perda perceptível)
OUTPUT_MAX_WIDTH=1300
JPEG_QUALITY=88

# Armazenamento do limitador de requisições (memory:// para instância única).
# Observação: com mais de 1 worker do Gunicorn, memory:// mantém contadores
# separados por worker (limites efetivos um pouco maiores). Para contagem
# exata, usar Redis: redis://host:6379
RATELIMIT_STORAGE_URI=memory://

# Porta interna do Gunicorn (mapeada para 5002 no host via docker-compose)
PORT=5002
